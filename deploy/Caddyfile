:8080 {
  root * /srv
  encode zstd gzip
  header X-Content-Type-Options nosniff
  handle /healthz {
    respond "ok" 200
  }
  @static path /_expo/* /assets/*
  handle @static {
    file_server
  }
  handle {
    header Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
