{
  "expo": {
    "name": "Malo",
    "slug": "malo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "말하기 연습을 위해 마이크를 사용해요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Malo · 말로",
      "shortName": "Malo",
      "lang": "ko",
      "themeColor": "#F3F2EE",
      "backgroundColor": "#F3F2EE"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "말하기 연습을 위해 마이크를 사용해요."
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "malo"
  }
}
